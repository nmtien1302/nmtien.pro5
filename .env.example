# Copy file này thành ".env" rồi sửa giá trị. File .env KHÔNG được đưa lên GitHub (đã có trong .gitignore).
# Biến đặt sẵn trên máy chủ (VD trong tab Environment của Render) luôn được ưu tiên hơn file .env.

# Mật khẩu đăng nhập trang /admin — BẮT BUỘC đặt trước khi đưa web lên mạng.
# Để trống thì server tạm dùng mật khẩu "admin123" và in cảnh báo khi chạy.
ADMIN_PASSWORD=

# Cổng chạy server (mặc định 3000). Cổng bận / bị chặn thì server tự thử cổng kế tiếp.
PORT=3000

# Địa chỉ lắng nghe (mặc định 0.0.0.0 = mọi địa chỉ). Chỉ muốn mở trên máy mình thì đặt 127.0.0.1
HOST=0.0.0.0

# Phiên đăng nhập admin kéo dài bao nhiêu giờ (mặc định 12)
SESSION_HOURS=12

# Độ dài tối đa của 1 lá thư (ký tự). Nên để trùng với letter.maxLength trong public/js/config.js
MAX_MESSAGE_LENGTH=1000

# Nếu chạy sau Nginx / Render / Railway (có reverse proxy) thì để true để lấy đúng IP người gửi (chống spam).
# Chạy trực tiếp không qua proxy thì đặt false.
TRUST_PROXY=true

# ---- Nơi lưu dữ liệu trên ổ đĩa ----
# Thư mục chứa letters.json, stats.json, content.json, media.json và thư mục uploads/ (ảnh / nhạc tải lên).
# Mặc định ./data (tính từ thư mục dự án). Có thể đặt đường dẫn tuyệt đối, VD ổ đĩa gắn thêm: DATA_DIR=/var/data
# (Khi dùng Upstash bên dưới thì mọi thứ lưu trên Upstash, biến này không còn tác dụng.)
DATA_DIR=./data

# ---- Giới hạn file tải lên ở trang admin (đơn vị MB) ----
# Ảnh: JPG, PNG, GIF, WebP, AVIF (mặc định 10 MB)
MAX_IMAGE_MB=10
# Nhạc: MP3, M4A, AAC, OGG, WAV, FLAC, WebM (mặc định 30 MB)
MAX_AUDIO_MB=30

# ---- Lưu trên Upstash Redis (tuỳ chọn) ----
# Chỉ cần khi đưa web lên host có ổ đĩa tạm (Render / Railway gói miễn phí) — xem README mục 5.
# Đặt đủ 2 biến thì thư, lượt xem, nội dung trang VÀ ảnh / nhạc tải lên đều lưu trên Upstash
# (gói miễn phí có giới hạn dung lượng — nhạc nặng nên để sẵn trong public/assets/music/).
# Để trống thì lưu vào thư mục DATA_DIR như bình thường.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tiền tố tên khoá trên Upstash (mặc định "profile" → profile:letters, profile:content, profile:blob:…).
# Chỉ đổi khi nhiều website dùng chung 1 database Upstash.
STORAGE_PREFIX=profile
